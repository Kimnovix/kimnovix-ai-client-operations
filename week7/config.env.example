# ====================================================================
# NOVA HIGHLANDS WEEKLY DIGEST - CLIENT CONFIGURATION
# ====================================================================
# Copy this file to "config.env" in the same folder and fill in your values.
# Keep "config.env" private; never commit it to Git.
# Notepad tip: turn on View > File name extensions in File Explorer so the
# file is saved as "config.env", not "config.env.txt".
# Check your settings any time with:
#     python week7\weekly_livestock_digest.py --check-config

# 1. Client & Data Source
#    Relative paths resolve from the week7 folder (where this file lives).
#    DATA_PATH can be one CSV, a folder of CSVs, or several separated by commas,
#    e.g. DATA_PATH=D:\FarmData\2026  or  DATA_PATH=nov.csv,dec.csv
CLIENT_NAME=Nova Highlands Livestock Ltd
DATA_PATH=sample_weekly_operations.csv

# 2. Sections & Alert Thresholds (codes must match the "section" column in the CSV;
#    FARM is reserved for the farm-wide total). One mortality threshold per section.
SECTIONS=BREEDING,FARROWING,WEANER,GROWER
MORTALITY_ALERT_PCT=BREEDING:0.50,FARROWING:3.00,WEANER:1.00,GROWER:0.50
FEED_USE_WATCH_PCT=10.00
FEED_PRICE_WATCH_PCT=5.00
FEED_PRICE_MIN_KES=20.00
FEED_PRICE_MAX_KES=150.00

# 3. AI Summary (Anthropic API key). The KPI tables are sent even when the
#    summary is unavailable.
ANTHROPIC_API_KEY=sk-ant-paste-your-real-key-here

# 4. Email Delivery (Gmail with 2-Step Verification + 16-character App Password,
#    not your normal Gmail password)
GMAIL_ADDRESS=your.farm.reports@gmail.com
GMAIL_APP_PASSWORD=paste-16-char-app-password
SENDER_NAME=Nova Highlands Farm Reports
# Comma-separated list (1 to 20 recipients). Replace every example.com address.
REPORT_RECIPIENTS=manager@example.com, finance@example.com, supervisor@example.com

# 5. Monday Morning Schedule (East Africa Time). After changing SCHEDULE_TIME,
#    run --install-task again so the scheduled task picks it up.
SCHEDULE_TIME=07:00
# 465 = SSL (Gmail default). 587 = STARTTLS also works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
