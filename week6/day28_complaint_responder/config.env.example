# ====================================================================
# CLIENT CONFIGURATION FILE (edit this file - do not edit Python code)
# ====================================================================
# Make a copy of this file in the same folder and name it exactly "config.env".
# Open it in Notepad, fill in your details, then File > Save.
# One setting per line. Do not put spaces around the = sign.

# 1. Your Anthropic AI API key (from console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=sk-ant-paste-your-real-key-here

# 2. Your business details (used automatically in the web app and replies)
COMPANY_NAME=SwiftLink Parcels Nairobi
BUSINESS_TYPE=same-day courier and parcel delivery service
SUPPORT_PHONE=0700 123 456
SUPPORT_EMAIL=care@swiftlink.co.ke
ESCALATION_WINDOW=15 minutes
BUSINESS_POLICY=Never blame the customer, never promise cash refunds or discounts without manager approval, always acknowledge the inconvenience, and commit to calling back within the escalation window with an update.

# 3. Appearance and app settings
# BRAND_COLOR must be a hex code such as #0f766e (find one by searching "color picker").
BRAND_COLOR=#0f766e
APP_PORT=5000
MAX_COMPLAINT_CHARS=3000

# 4. AI model (leave as default unless instructed by support)
# Supported: claude-haiku-5-5 (default, lowest cost), claude-sonnet-5-5 (premium), claude-haiku-4-5-20251001
AI_MODEL=claude-haiku-5-5
