# Copy this file to .env (run.bat does it on first run) and enter your real values.
# On Render, set the same names under Environment instead; they override this file.
ANTHROPIC_API_KEY=sk-ant-paste-your-real-key-here

COMPANY_NAME=Nova Agro-Vet & Feeds Ltd
BUSINESS_LOCATION=Eldoret, Kenya
SUPPORT_PHONE=0700 412 890
SUPPORT_EMAIL=care@novaagrovet.co.ke
BRAND_COLOR=#0f766e

# Models: claude-haiku-5-5 (default) or claude-haiku-4-5-20251001
AI_MODEL=claude-haiku-5-5

# Optional: another folder of business documents (relative paths start from this folder)
# DOCS_DIR=docs

# Spend guard for a public deployment (0 turns a limit off)
RATE_LIMIT_PER_10_MIN=20
DAILY_CHAT_CAP=1000

# Local server settings (Render sets PORT and RENDER_EXTERNAL_HOSTNAME automatically)
HOST=127.0.0.1
PORT=5000
ALLOWED_HOSTS=127.0.0.1,localhost
